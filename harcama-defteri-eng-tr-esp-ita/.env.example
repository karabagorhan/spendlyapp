# Kopyala: cp .env.example .env   (.env git'e girmez)
# Yalnızca HERKESE AÇIK değerler: EXPO_PUBLIC_* uygulamanın içine gömülür.
# service_role anahtarı ve Apple .p8 buraya KONMAZ (yalnızca `supabase secrets set`).
EXPO_PUBLIC_SUPABASE_URL=https://<proje-kimligi>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-anahtari>
# Üretimde ASLA 1 yapma: sahte hesap servisini açar (yalnızca arayüz testleri için)
# EXPO_PUBLIC_AUTH_MOCK=1
