{
  "expo": {
    "name": "Monibo",
    "slug": "harcama-defteri-eng-tr-esp-ita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.karabag.harcamadefteri.global",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.karabag.harcamadefteri.global"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/without-push-entitlement.js",
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Monibo to use Face ID to unlock your data."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0D0F",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0D0F"
          }
        }
      ],
      "expo-localization"
    ],
    "scheme": "harcama",
    "owner": "karabagorhans-team",
    "extra": {
      "eas": {
        "projectId": "065165d8-42b7-447e-9960-e8263cf7d992"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/065165d8-42b7-447e-9960-e8263cf7d992"
    },
    "locales": {
      "en": "./locales/en.json",
      "tr": "./locales/tr.json",
      "es": "./locales/es.json",
      "it": "./locales/it.json",
      "zh-Hans": "./locales/zh-Hans.json"
    }
  }
}
