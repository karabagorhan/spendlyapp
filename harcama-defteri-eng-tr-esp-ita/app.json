{
  "expo": {
    "name": "Spendly",
    "slug": "harcama-defteri-eng-tr-esp-ita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.karabag.harcamadefteri.global",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F5AA8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.karabag.harcamadefteri.global"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      ["expo-local-authentication", { "faceIDPermission": "Allow Spendly to use Face ID to unlock your data." }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6FB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B1220"
          }
        }
      ]
    ],
    "scheme": "harcama",
    "owner": "karabagorhans-team",
    "extra": {
      "eas": {
        "projectId": "065165d8-42b7-447e-9960-e8263cf7d992"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/065165d8-42b7-447e-9960-e8263cf7d992"
    }
  }
}
